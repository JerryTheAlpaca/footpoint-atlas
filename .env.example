# 复制为 .env 后填写。不要提交真实值。
TRAIN_AUTH_USERNAME=your-account
TRAIN_AUTH_PASSWORD_HASH=replace-with-tools-make-password-hash-output
TRAIN_SESSION_SECRET=replace-with-at-least-32-random-characters
TRAIN_COOKIE_SECURE=1

# 可选：接入 Jerry Ledger 的父域共享会话。配置后不再使用本站独立登录页。
# TRAIN_SSO_SESSION_URL=http://ledger-auth:3000/api/auth/session
# TRAIN_SSO_LOGOUT_URL=http://ledger-auth:3000/api/auth/logout
# TRAIN_SSO_LOGIN_URL=https://auth.jerrythealpaca.cn/login
# TRAIN_SSO_PUBLIC_ORIGIN=https://atlas.jerrythealpaca.cn
# TRAIN_SSO_COOKIE_NAME=__Secure-jerry_session
# TRAIN_SSO_COOKIE_DOMAIN=.jerrythealpaca.cn

# 可选：服务器上的持久化数据目录和容器运行用户。
HOST_DATA_DIR=/opt/footpoint-atlas-data
APP_UID=1000
APP_GID=1000
