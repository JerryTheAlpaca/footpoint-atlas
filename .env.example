# 复制为 .env 后填写。不要提交真实值。
TRAIN_AUTH_USERNAME=your-account
TRAIN_AUTH_PASSWORD_HASH=replace-with-tools-make-password-hash-output
TRAIN_SESSION_SECRET=replace-with-at-least-32-random-characters
TRAIN_COOKIE_SECURE=1

# 可选：服务器上的持久化数据目录和容器运行用户。
HOST_DATA_DIR=/opt/footpoint-atlas-data
APP_UID=1000
APP_GID=1000
